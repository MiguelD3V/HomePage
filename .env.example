# Copie para .env.local e preencha. .env.local não vai para o git.

# O formulário de leads não depende de nenhuma variável de ambiente: o envio
# abre o WhatsApp direto no navegador do visitante (número em lib/site.ts).

# --- Analytics -----------------------------------------------------------
# Opcionais. Em branco, nenhum script é carregado.
NEXT_PUBLIC_GA_ID=            # G-XXXXXXXXXX (Google Analytics 4)
NEXT_PUBLIC_META_PIXEL_ID=    # ID numérico do Meta Pixel
