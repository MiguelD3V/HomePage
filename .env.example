# Copie para .env.local e preencha. .env.local não vai para o git.

# --- Entrega dos leads -------------------------------------------------------
# Sem NENHUMA destas configuradas, a Server Action falha em produção de
# propósito: aceitar o lead em silêncio e perdê-lo é pior do que mostrar erro
# e oferecer o WhatsApp como alternativa.

# Envio por e-mail (Resend)
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# Opcional: webhook de CRM. Recebe o mesmo payload em JSON.
LEAD_WEBHOOK_URL=

# --- Analytics ---------------------------------------------------------------
# ⚠️ PENDENTE: preencher e ligar os scripts via @next/third-parties
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
